# Copy to .env.local (local dev) and add the same names in Vercel → Project → Settings →
# Environment Variables. Everything works without them; each one upgrades a feature.

# "Ask Bindu" live agent (Google Gemini). Get a key at https://aistudio.google.com/apikey
# Without it, Bindu answers from her offline field guide (built from profile.ts).
GEMINI_API_KEY=

# Optional: override the agent's model (default gemini-3.5-flash-lite). BINDU_MODEL also works.
GEMINI_MODEL=

# Optional: read-only GitHub token for the contribution terrain and higher API limits.
GITHUB_TOKEN=

# Optional: canonical site URL for OG images and the sitemap (default http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
